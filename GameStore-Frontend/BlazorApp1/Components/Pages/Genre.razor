@page "/genre"
@rendermode InteractiveServer

<PageTitle>Game Genre</PageTitle>

<h1>Genre</h1>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger" role="alert">@error</div>
}
else if (genres is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Genre</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var genre in genres)
            {
                <tr>
                    <td>@genre.Name</td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    [Inject] private GameStoreApiClient ApiClient { get; set; } = default!;

    private static readonly string[] PreferredGenres = ["Fighting", "Sports", "Action", "RPG", "Puzzle"];

    private List<GenreDto>? genres;
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var apiGenres = await ApiClient.GetGenresAsync();
            genres = PreferredGenres
                .Join(
                    apiGenres,
                    required => required,
                    genre => genre.Name,
                    (_, genre) => genre,
                    StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception ex)
        {
            error = $"Could not load genres: {ex.Message}";
        }
    }
}
